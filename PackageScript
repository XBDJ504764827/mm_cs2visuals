import glob
import os

builder.SetBuildFolder('package')


class SDKPackage:
  def __init__(self, cxx, sdk_name):
    self.sdk_name = sdk_name
    self.plugin_folder_path = os.path.join('addons', MMSPlugin.metadata['name'])
    self.bin_path = None

    builder.AddFolder(self.plugin_folder_path)
    builder.AddFolder(os.path.join('addons', 'metamod'))
    self.add_bin_folder(cxx)
    self.generate_vdf()

  def add_bin_folder(self, cxx):
    platform64_path_map = {
      'windows': 'win64',
      'linux': 'linuxsteamrt64',
      'mac': 'osx64',
    }
    if cxx.target.arch == 'x86_64':
      self.bin_path = os.path.join(
        self.plugin_folder_path, 'bin', platform64_path_map[cxx.target.platform]
      )
    else:
      self.bin_path = os.path.join(self.plugin_folder_path, 'bin')
    builder.AddFolder(self.bin_path)

  def generate_vdf(self):
    binary_path = os.path.join(self.bin_path, MMSPlugin.metadata['name']).replace(os.sep, '/')
    content = '"Metamod Plugin"\n{\n'
    content += f'\t"alias"\t"{MMSPlugin.metadata["alias"]}"\n'
    content += f'\t"file"\t"{binary_path}"\n'
    content += '}'
    builder.AddOutputFile(
      os.path.join('addons', 'metamod', f'{MMSPlugin.metadata["name"]}.vdf'),
      content.encode('utf8'),
    )

  def add_binary(self, binary):
    extension = os.path.splitext(os.path.basename(binary.path))[1]
    builder.AddCopy(binary, os.path.join(self.bin_path, MMSPlugin.metadata['name'] + extension))


packages = {}
for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  packages[sdk['name']] = SDKPackage(sdk_target.cxx, sdk['name'])

for task in MMSPlugin.binaries:
  binary_filename = os.path.splitext(os.path.basename(task.binary.path))[0]
  sdk_name = binary_filename.split('.')[-1]
  packages[sdk_name].add_binary(task.binary)

# Keep server configuration in the same layout as a CS2 installation.
cfg_src = os.path.join(builder.sourcePath, 'configs', 'cs2visuals')
cfg_dst = os.path.join('cfg', 'cs2visuals')
builder.AddFolder(cfg_dst)
for cfg_file in glob.glob(os.path.join(cfg_src, '*.cfg')):
  builder.AddCopy(cfg_file, os.path.join(cfg_dst, os.path.basename(cfg_file)))

# Signature/offset reference for the post-processing runtime. The binary
# embeds the patterns for compatibility, while shipping this file makes the
# required server ABI assumptions visible to administrators.
gamedata_src = os.path.join(builder.sourcePath, 'gamedata', 'cs2visuals.games.txt')
gamedata_dst = os.path.join('addons', MMSPlugin.metadata['name'], 'gamedata')
builder.AddFolder(gamedata_dst)
if os.path.exists(gamedata_src):
  builder.AddCopy(gamedata_src, os.path.join(gamedata_dst, 'cs2visuals.games.txt'))

with open(os.path.join(builder.buildPath, 'pdblog.txt'), 'wt') as fp:
  for task in MMSPlugin.binaries:
    if task.debug:
      fp.write(task.debug.path + '\n')
